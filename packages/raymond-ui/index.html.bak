<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Raymond — Knowledge Graph Visualizer & Explorer</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🕸️</text></svg>">
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#ecfdf5',
              400: '#34d399',
              500: '#10b981',
              600: '#059669',
              700: '#047857',
            },
            dark: {
              950: '#090d16',
              900: '#0f172a',
              850: '#131d35',
              800: '#1e293b',
              700: '#334155',
            }
          }
        }
      }
    }
  </script>

  <!-- Vis Network CDN -->
  <script src="https://unpkg.com/vis-network@9.1.9/standalone/umd/vis-network.min.js"></script>

  <!-- Lucide Icons CDN -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Marked.js Markdown Parser -->
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

  <style>
    /* Custom scrollbars */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0f172a;
    }
    ::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 3px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #475569;
    }

    /* Markdown prose styles in inspector */
    .prose-dark {
      color: #cbd5e1;
      font-size: 0.775rem;
      line-height: 1.45rem;
      word-break: break-word;
    }
    .prose-dark p {
      margin-bottom: 0.6rem;
    }
    .prose-dark p:last-child {
      margin-bottom: 0;
    }
    .prose-dark h1, .prose-dark h2, .prose-dark h3, .prose-dark h4 {
      color: #f8fafc;
      font-weight: 700;
      margin-top: 0.9rem;
      margin-bottom: 0.35rem;
    }
    .prose-dark h1 { font-size: 0.95rem; }
    .prose-dark h2 { font-size: 0.875rem; border-bottom: 1px solid #334155; padding-bottom: 0.2rem; }
    .prose-dark h3 { font-size: 0.8rem; color: #38bdf8; }
    .prose-dark ul, .prose-dark ol {
      margin-left: 1.25rem;
      margin-bottom: 0.6rem;
    }
    .prose-dark ul { list-style-type: disc; }
    .prose-dark ol { list-style-type: decimal; }
    .prose-dark li {
      margin-bottom: 0.25rem;
    }
    .prose-dark code {
      background-color: #090d16;
      border: 1px solid #334155;
      color: #38bdf8;
      padding: 0.15rem 0.35rem;
      border-radius: 0.25rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.725rem;
    }
    .prose-dark pre {
      background-color: #050811;
      border: 1px solid #1e293b;
      border-radius: 0.5rem;
      padding: 0.6rem;
      margin: 0.5rem 0;
      overflow-x: auto;
    }
    .prose-dark pre code {
      background: transparent;
      border: 0;
      padding: 0;
      color: #a5f3fc;
    }
    .prose-dark blockquote {
      border-left: 3px solid #10b981;
      padding-left: 0.6rem;
      color: #94a3b8;
      font-style: italic;
      margin: 0.5rem 0;
    }
    .prose-dark a {
      color: #34d399;
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .prose-dark hr {
      border: 0;
      border-top: 1px solid #334155;
      margin: 0.75rem 0;
    }
    /* Vis network navigation overrides for sleek dark look */
    .vis-network div.vis-navigation div.vis-button {
      background-color: #1e293b !important;
      border: 1px solid #334155 !important;
      border-radius: 8px !important;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.4) !important;
    }
    .vis-network div.vis-navigation div.vis-button:hover {
      background-color: #334155 !important;
    }
  </style>
</head>
<body class="bg-dark-950 text-slate-100 h-screen w-screen flex flex-col overflow-hidden font-sans antialiased select-none">

  <!-- ================= TOP NAVIGATION / HEADER ================= -->
  <header class="h-14 border-b border-slate-800 bg-dark-900/90 backdrop-blur px-4 flex items-center justify-between z-20 shrink-0">
    <!-- Left: Brand & Status -->
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 font-bold text-lg shadow-sm">
          🕸️
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="font-bold tracking-tight text-white text-base">Raymond</span>
            <span class="text-xs px-2 py-0.5 rounded-full bg-emerald-950/80 text-emerald-400 border border-emerald-800/60 font-medium">KG Viewer</span>
          </div>
        </div>
      </div>

      <div class="h-5 w-px bg-slate-800 mx-1"></div>

      <!-- Live Connection Status Badge -->
      <button id="btnConnectionStatus" onclick="openSettingsModal()" class="flex items-center gap-2 px-2.5 py-1 rounded-md bg-dark-800 hover:bg-dark-700 border border-slate-700/80 transition text-xs text-slate-300">
        <span id="statusIndicator" class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        <span id="statusText">Demo Dataset</span>
      </button>

      <!-- Refresh Button -->
      <button id="btnSync" onclick="refreshData()" title="Reload from source" class="p-1.5 rounded-md hover:bg-dark-800 text-slate-400 hover:text-white transition border border-transparent hover:border-slate-700">
        <i data-lucide="refresh-cw" class="w-4 h-4"></i>
      </button>
    </div>

    <!-- Center: Search Bar & Auto-Focus -->
    <div class="relative w-80 max-w-sm">
      <div class="relative">
        <i data-lucide="search" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none"></i>
        <input 
          type="text" 
          id="searchInput" 
          placeholder="Search entities, types, aliases..." 
          class="w-full pl-9 pr-8 py-1.5 bg-dark-800 border border-slate-700/80 rounded-lg text-xs text-white placeholder-slate-400 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition"
          oninput="handleSearch(this.value)"
        >
        <button id="btnClearSearch" onclick="clearSearch()" class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white text-xs">
          ✕
        </button>
      </div>
      <!-- Autocomplete Dropdown -->
      <div id="searchDropdown" class="hidden absolute top-full mt-1.5 left-0 right-0 max-h-60 overflow-y-auto bg-dark-800 border border-slate-700 rounded-lg shadow-xl z-50 py-1"></div>
    </div>

    <!-- Right: Stats & Action Tools -->
    <div class="flex items-center gap-2">
      <!-- Counters Pill -->
      <div class="hidden md:flex items-center gap-3 px-3 py-1 bg-dark-800/80 border border-slate-800 rounded-md text-xs text-slate-400 font-mono">
        <div><span id="statEntities" class="text-emerald-400 font-semibold">0</span> entities</div>
        <div class="w-1 h-1 rounded-full bg-slate-700"></div>
        <div><span id="statRelations" class="text-sky-400 font-semibold">0</span> relations</div>
        <div class="w-1 h-1 rounded-full bg-slate-700"></div>
        <div><span id="statMemories" class="text-purple-400 font-semibold">0</span> memories</div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex items-center gap-1 border-l border-slate-800 pl-2">
        <button onclick="fitGraph()" title="Fit View to All Nodes" class="p-1.5 rounded-md hover:bg-dark-800 text-slate-400 hover:text-white transition border border-transparent hover:border-slate-700">
          <i data-lucide="maximize" class="w-4 h-4"></i>
        </button>
        <button id="btnPhysicsToggle" onclick="togglePhysics()" title="Toggle Physics Simulation" class="p-1.5 rounded-md hover:bg-dark-800 text-emerald-400 hover:text-emerald-300 transition border border-transparent hover:border-slate-700">
          <i data-lucide="activity" class="w-4 h-4"></i>
        </button>
        <button id="btnLayoutToggle" onclick="toggleLayoutMode()" title="Toggle Hierarchical / Force Layout" class="p-1.5 rounded-md hover:bg-dark-800 text-slate-400 hover:text-white transition border border-transparent hover:border-slate-700">
          <i data-lucide="git-fork" class="w-4 h-4"></i>
        </button>
        <button onclick="exportPNG()" title="Export PNG Screenshot" class="p-1.5 rounded-md hover:bg-dark-800 text-slate-400 hover:text-white transition border border-transparent hover:border-slate-700">
          <i data-lucide="camera" class="w-4 h-4"></i>
        </button>
        <button onclick="openSettingsModal()" title="Supabase API Settings" class="p-1.5 rounded-md hover:bg-dark-800 text-slate-400 hover:text-white transition border border-transparent hover:border-slate-700">
          <i data-lucide="settings" class="w-4 h-4"></i>
        </button>
      </div>
    </div>
  </header>

  <!-- ================= MAIN WORKSPACE AREA ================= -->
  <div class="relative flex-1 flex overflow-hidden">
    
    <!-- Floating Filter Controls Bar (Left Top) -->
    <div class="absolute top-3 left-3 z-10 flex flex-col gap-2 max-w-sm pointer-events-none">
      <!-- Entity Type Filter Chips -->
      <div class="pointer-events-auto bg-dark-900/90 backdrop-blur-md border border-slate-800 rounded-xl p-2.5 shadow-xl">
        <div class="flex items-center justify-between mb-2">
          <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider flex items-center gap-1.5">
            <i data-lucide="filter" class="w-3 h-3 text-slate-400"></i> Entity Types
          </span>
          <button onclick="resetFilters()" class="text-[10px] text-emerald-400 hover:underline">Reset</button>
        </div>
        <div id="typeFilterPills" class="flex flex-wrap gap-1.5 max-h-32 overflow-y-auto pr-1"></div>
      </div>

      <!-- Display Options -->
      <div class="pointer-events-auto bg-dark-900/90 backdrop-blur-md border border-slate-800 rounded-xl p-2.5 shadow-xl flex items-center justify-between text-xs">
        <label class="flex items-center gap-2 cursor-pointer select-none">
          <input type="checkbox" id="chkShowSuperseded" onchange="toggleSuperseded(this.checked)" class="rounded bg-dark-800 border-slate-700 text-emerald-500 focus:ring-0">
          <span class="text-slate-300">Show Superseded Links</span>
        </label>
        <span id="supersededCountPill" class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-red-950/60 text-red-400 border border-red-900/60">0</span>
      </div>

      <!-- Hop Focus Mode Pill -->
      <div id="focusModeBox" class="hidden pointer-events-auto bg-dark-900/90 backdrop-blur-md border border-slate-800 rounded-xl p-2.5 shadow-xl flex items-center justify-between text-xs">
        <div class="flex items-center gap-1.5 text-slate-300">
          <i data-lucide="crosshair" class="w-3.5 h-3.5 text-emerald-400"></i>
          <span>Neighborhood Focus:</span>
          <span id="focusEntityName" class="font-medium text-white truncate max-w-[100px]">Node</span>
        </div>
        <button onclick="clearFocusMode()" class="text-xs text-red-400 hover:text-red-300 font-medium ml-2">Exit</button>
      </div>
    </div>

    <!-- Graph Canvas Container -->
    <div id="graphContainer" class="flex-1 w-full h-full bg-[#080d19]"></div>

    <!-- Floating Empty / Helper Badge (Bottom Left) -->
    <div class="absolute bottom-3 left-3 z-10 pointer-events-none bg-dark-900/80 backdrop-blur border border-slate-800/80 rounded-lg px-3 py-1.5 text-[11px] text-slate-400 flex items-center gap-3">
      <span>🖱️ Click node/edge to inspect</span>
      <span>•</span>
      <span>Double click to focus neighborhood</span>
      <span>•</span>
      <span>Scroll to zoom</span>
    </div>

    <!-- ================= RIGHT SLIDE-OVER INSPECTOR DRAWER ================= -->
    <aside id="inspectorDrawer" class="w-96 max-w-full border-l border-slate-800 bg-dark-900/95 backdrop-blur-md flex flex-col z-20 transition-transform duration-300 ease-in-out translate-x-full shadow-2xl">
      <!-- Drawer Header -->
      <div class="h-14 border-b border-slate-800 px-4 flex items-center justify-between shrink-0">
        <div class="flex items-center gap-2 overflow-hidden">
          <i id="inspectorIcon" data-lucide="circle-dot" class="w-4 h-4 text-emerald-400 shrink-0"></i>
          <h2 id="inspectorTitle" class="text-sm font-bold text-white truncate">Inspector</h2>
        </div>
        <div class="flex items-center gap-1">
          <button id="btnToggleDrawerWidth" onclick="toggleDrawerWidth()" title="Toggle Wide View (Markdown reading)" class="p-1 rounded-md text-slate-400 hover:text-white hover:bg-dark-800 transition">
            <i id="iconDrawerWidth" data-lucide="maximize-2" class="w-4 h-4"></i>
          </button>
          <button onclick="closeInspector()" class="p-1 rounded-md text-slate-400 hover:text-white hover:bg-dark-800 transition">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>
      </div>

      <!-- Drawer Scrollable Content -->
      <div id="inspectorContent" class="flex-1 overflow-y-auto p-4 space-y-5 text-xs text-slate-300">
        <!-- Content will be rendered dynamically -->
      </div>
    </aside>
  </div>

  <!-- ================= SETTINGS & SUPABASE CREDENTIALS MODAL ================= -->
  <div id="settingsModal" class="hidden fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-dark-900 border border-slate-800 rounded-2xl shadow-2xl overflow-hidden flex flex-col">
      <!-- Modal Header -->
      <div class="px-5 py-4 border-b border-slate-800 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400">
            <i data-lucide="database" class="w-4 h-4"></i>
          </div>
          <h3 class="font-bold text-white text-sm">Supabase Connection Settings</h3>
        </div>
        <button onclick="closeSettingsModal()" class="text-slate-400 hover:text-white">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>

      <!-- Modal Body -->
      <div class="p-5 space-y-4 text-xs">
        <p class="text-slate-400 leading-relaxed">
          Connect directly to your Supabase PostgreSQL tables (<code class="text-emerald-400 font-mono">public.entities</code>, <code class="text-emerald-400 font-mono">public.relations</code>, <code class="text-emerald-400 font-mono">public.memories</code>).
        </p>

        <div>
          <label class="block text-slate-300 font-medium mb-1">Supabase URL</label>
          <input 
            type="url" 
            id="cfgSupabaseUrl" 
            placeholder="https://xyzcompany.supabase.co" 
            class="w-full px-3 py-2 bg-dark-800 border border-slate-700 rounded-lg text-white font-mono placeholder-slate-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"
          >
        </div>

        <div>
          <label class="block text-slate-300 font-medium mb-1">Supabase API Key (Anon or Service Role)</label>
          <input 
            type="password" 
            id="cfgSupabaseKey" 
            placeholder="eyJh..." 
            class="w-full px-3 py-2 bg-dark-800 border border-slate-700 rounded-lg text-white font-mono placeholder-slate-500 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"
          >
          <span class="text-[10px] text-slate-500 mt-1 block">Saved in browser's local storage only. Never sent to any 3rd party.</span>
        </div>

        <div id="modalStatusAlert" class="hidden p-3 rounded-lg border text-xs"></div>
      </div>

      <!-- Modal Footer -->
      <div class="px-5 py-3 border-t border-slate-800 bg-dark-950 flex items-center justify-between">
        <button onclick="loadDemoDataset()" class="px-3 py-1.5 rounded-lg bg-dark-800 hover:bg-dark-700 text-slate-300 border border-slate-700 transition text-xs flex items-center gap-1.5">
          <i data-lucide="sparkles" class="w-3.5 h-3.5 text-amber-400"></i> Load Demo Graph
        </button>
        <div class="flex items-center gap-2">
          <button onclick="closeSettingsModal()" class="px-3 py-1.5 rounded-lg hover:bg-dark-800 text-slate-400 hover:text-white transition text-xs">
            Cancel
          </button>
          <button onclick="saveAndConnectSupabase()" class="px-4 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-semibold shadow-lg shadow-emerald-900/40 transition text-xs flex items-center gap-1.5">
            <i data-lucide="check" class="w-3.5 h-3.5"></i> Connect & Sync
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ================= JAVASCRIPT APPLICATION LOGIC ================= -->
  <script>
    // --- STATE MANAGEMENT ---
    let network = null;
    let rawEntities = [];
    let rawRelations = [];
    let rawMemories = [];
    let rawMemoryEntities = [];
    
    let isPhysicsActive = true;
    let isHierarchical = false;
    let activeTypeFilters = new Set();
    let showSuperseded = false;
    let selectedEntityId = null;
    let focusCenterEntityId = null;
    let focusHopDepth = 0; // 0 = all nodes

    // Visual Palette by Entity Type
    const TYPE_STYLES = {
      concept: { bg: '#8B5CF6', border: '#A78BFA', highlight: '#C4B5FD', badge: 'bg-purple-950/80 text-purple-300 border-purple-800/80' },
      component: { bg: '#0284C7', border: '#38BDF8', highlight: '#7DD3FC', badge: 'bg-sky-950/80 text-sky-300 border-sky-800/80' },
      technology: { bg: '#059669', border: '#34D399', highlight: '#6EE7B7', badge: 'bg-emerald-950/80 text-emerald-300 border-emerald-800/80' },
      decision: { bg: '#D97706', border: '#FBBF24', highlight: '#FDE68A', badge: 'bg-amber-950/80 text-amber-300 border-amber-800/80' },
      agent: { bg: '#E11D48', border: '#FB7185', highlight: '#FDA4AF', badge: 'bg-rose-950/80 text-rose-300 border-rose-800/80' },
      system: { bg: '#4F46E5', border: '#818CF8', highlight: '#A5B4FC', badge: 'bg-indigo-950/80 text-indigo-300 border-indigo-800/80' },
      tool: { bg: '#0D9488', border: '#2DD4BF', highlight: '#5EEAD4', badge: 'bg-teal-950/80 text-teal-300 border-teal-800/80' },
      default: { bg: '#475569', border: '#94A3B8', highlight: '#CBD5E1', badge: 'bg-slate-800 text-slate-300 border-slate-700' }
    };

    function getTypeStyle(type) {
      const key = (type || '').toLowerCase();
      return TYPE_STYLES[key] || TYPE_STYLES.default;
    }

    // --- BUILT-IN REALISTIC DEMO DATASET ---
    const DEMO_DATASET = {
      entities: [
        { id: "e1", name: "TokenVault", type: "component", aliases: ["Vault", "KeyVault"], metadata: { language: "TypeScript", file: "src/crypto/vault.ts" } },
        { id: "e2", name: "AES-256-GCM", type: "technology", aliases: ["AES-GCM", "AES256"], metadata: { standard: "NIST SP 800-38D", key_bits: 256 } },
        { id: "e3", name: "PBKDF2", type: "technology", aliases: ["KeyDerivation"], metadata: { rounds: 100000, hash: "SHA-256" } },
        { id: "e4", name: "OAuth", type: "concept", aliases: ["OAuth2"], metadata: { rfc: "RFC 6749" } },
        { id: "e5", name: "Supabase Edge Functions", type: "system", aliases: ["Edge Runtime", "Deno Edge"], metadata: { provider: "Supabase" } },
        { id: "e6", name: "pgvector", type: "technology", aliases: ["vector", "embeddings-store"], metadata: { index: "HNSW", metric: "cosine" } },
        { id: "e7", name: "Google Gemini Embeddings", type: "system", aliases: ["gemini-embedding-001"], metadata: { dimensions: 768, freeTier: true } },
        { id: "e8", name: "Raymond Memory Server", type: "component", aliases: ["Raymond", "RaymondMemorySystem"], metadata: { protocol: "MCP", version: "1.1.0" } },
        { id: "e9", name: "Antigravity Coordinator", type: "agent", aliases: ["Coordinator", "AGY"], metadata: { role: "fleet-lead" } },
        { id: "e10", name: "Coder Agent", type: "agent", aliases: ["coder_agent"], metadata: { role: "implementation" } },
        { id: "e11", name: "Quota-Aware SHA-256 Cache", type: "decision", aliases: ["HashCache"], metadata: { status: "implemented", savings: "100% on duplicate texts" } },
        { id: "e12", name: "DES Encryption", type: "technology", aliases: ["DES"], metadata: { deprecated: true } },
      ],
      relations: [
        { id: "r1", src: "e1", dst: "e2", predicate: "uses", valid_from: "2026-11-15T12:00:00Z", valid_to: null, memory_id: "m1" },
        { id: "r2", src: "e1", dst: "e3", predicate: "uses", valid_from: "2026-11-15T12:00:00Z", valid_to: null, memory_id: "m1" },
        { id: "r3", src: "e1", dst: "e4", predicate: "protects", valid_from: "2026-11-15T12:00:00Z", valid_to: null, memory_id: "m1" },
        { id: "r4", src: "e8", dst: "e5", predicate: "runs_on", valid_from: "2026-11-15T14:00:00Z", valid_to: null, memory_id: "m2" },
        { id: "r5", src: "e8", dst: "e6", predicate: "stores_in", valid_from: "2026-11-15T14:00:00Z", valid_to: null, memory_id: "m2" },
        { id: "r6", src: "e8", dst: "e7", predicate: "queries", valid_from: "2026-11-15T14:00:00Z", valid_to: null, memory_id: "m2" },
        { id: "r7", src: "e8", dst: "e11", predicate: "implements", valid_from: "2026-11-16T10:00:00Z", valid_to: null, memory_id: "m3" },
        { id: "r8", src: "e9", dst: "e8", predicate: "coordinates_via", valid_from: "2026-11-16T11:00:00Z", valid_to: null, memory_id: "m4" },
        { id: "r9", src: "e10", dst: "e8", predicate: "queries", valid_from: "2026-11-16T11:00:00Z", valid_to: null, memory_id: "m4" },
        { id: "r10", src: "e10", dst: "e1", predicate: "implements", valid_from: "2026-11-16T12:00:00Z", valid_to: null, memory_id: "m1" },
        // Superseded historical relation demonstrating temporal validity
        { id: "r11", src: "e1", dst: "e12", predicate: "uses", valid_from: "2026-11-14T09:00:00Z", valid_to: "2026-11-15T12:00:00Z", memory_id: "m5" }
      ],
      memories: [
        {
          id: "m1",
          agent_id: "coder_agent",
          session_id: "session_sec_audit",
          category: "decision",
          content: "TokenVault requires AES-256-GCM encryption with PBKDF2 key derivation for OAuth tokens to satisfy security compliance.",
          tags: ["security", "oauth", "crypto", "tokenvault"],
          created_at: "2026-11-15T12:00:00Z",
          metadata: { ticket: "SEC-104", verified: true }
        },
        {
          id: "m2",
          agent_id: "antigravity_lead",
          session_id: "arch_review",
          category: "fact",
          content: "Raymond Edge memory server deployed onto Supabase Edge Runtime (Deno), connecting to pgvector with HNSW index and Gemini 768-dim embeddings.",
          tags: ["architecture", "supabase", "pgvector", "gemini"],
          created_at: "2026-11-15T14:00:00Z",
          metadata: { env: "production", latency_p95: "85ms" }
        },
        {
          id: "m3",
          agent_id: "coder_agent",
          session_id: "perf_optimization",
          category: "decision",
          content: "Added SHA-256 content deduplication cache to store_memory to prevent duplicate embedding API calls and conserve Gemini rate quotas.",
          tags: ["performance", "caching", "gemini", "quota"],
          created_at: "2026-11-16T10:00:00Z",
          metadata: { savings_pct: 100 }
        },
        {
          id: "m4",
          agent_id: "antigravity_lead",
          session_id: "fleet_coordination",
          category: "instruction",
          content: "All autonomous agents must invoke recall_shared_memories before inspecting files to avoid redundant investigation and token waste.",
          tags: ["fleet", "guidelines", "coordination"],
          created_at: "2026-11-16T11:00:00Z",
          metadata: { mandatory: true }
        },
        {
          id: "m5",
          agent_id: "legacy_system",
          session_id: "legacy_v1",
          category: "summary",
          content: "Legacy Vault initially used basic DES cipher before being completely superseded by AES-256-GCM.",
          tags: ["legacy", "deprecation"],
          created_at: "2026-11-14T09:00:00Z",
          metadata: { status: "deprecated" }
        }
      ],
      memory_entities: [
        { memory_id: "m1", entity_id: "e1" },
        { memory_id: "m1", entity_id: "e2" },
        { memory_id: "m1", entity_id: "e3" },
        { memory_id: "m1", entity_id: "e4" },
        { memory_id: "m2", entity_id: "e5" },
        { memory_id: "m2", entity_id: "e6" },
        { memory_id: "m2", entity_id: "e7" },
        { memory_id: "m2", entity_id: "e8" },
        { memory_id: "m3", entity_id: "e8" },
        { memory_id: "m3", entity_id: "e11" },
        { memory_id: "m4", entity_id: "e8" },
        { memory_id: "m4", entity_id: "e9" },
        { memory_id: "m4", entity_id: "e10" },
        { memory_id: "m5", entity_id: "e1" },
        { memory_id: "m5", entity_id: "e12" }
      ]
    };

    // --- INITIALIZATION ---
    window.addEventListener('DOMContentLoaded', () => {
      lucide.createIcons();
      initNetwork();
      loadStoredCredentials();
      autoConnectOrDemo();
    });

    function loadStoredCredentials() {
      // Check URL parameters first (e.g. ?supabaseUrl=...&supabaseKey=...)
      const urlParams = new URLSearchParams(window.location.search);
      const urlParam = urlParams.get('supabaseUrl') || urlParams.get('url');
      const keyParam = urlParams.get('supabaseKey') || urlParams.get('key') || urlParams.get('apikey');

      const savedUrl = urlParam || localStorage.getItem('raymond_supabase_url') || (window.__DEFAULT_SUPABASE_URL__ || '');
      const savedKey = keyParam || localStorage.getItem('raymond_supabase_key') || (window.__DEFAULT_SUPABASE_KEY__ || '');

      document.getElementById('cfgSupabaseUrl').value = savedUrl;
      document.getElementById('cfgSupabaseKey').value = savedKey;
    }

    async function autoConnectOrDemo() {
      // 1. Check local proxy tool (/api/graph) first!
      try {
        const proxyRes = await fetch('/api/graph');
        if (proxyRes.ok) {
          const graphJson = await proxyRes.json();
          if (graphJson && graphJson.entities) {
            applyGraphJson(graphJson, 'Live Edge Proxy');
            return;
          }
        }
      } catch (_) {
        // Proxy not running
      }

      // 2. Try configured credentials
      const url = document.getElementById('cfgSupabaseUrl').value.trim();
      const key = document.getElementById('cfgSupabaseKey').value.trim();

      if (url && key) {
        try {
          await fetchFromSupabase(url, key);
          return;
        } catch (e) {
          console.warn("Auto-connect failed, falling back to demo dataset:", e);
        }
      }
      loadDemoDataset();
    }

    function applyGraphJson(graphJson, sourceLabel = 'Live Proxy') {
      rawEntities = graphJson.entities || [];
      rawRelations = graphJson.relations || [];
      rawMemories = graphJson.memories || [];
      rawMemoryEntities = graphJson.memory_entities || [];

      updateStatusBadge('connected', sourceLabel);
      closeSettingsModal();
      renderGraph();
      setTimeout(fitGraph, 300);
    }

    // --- VIS NETWORK SETUP ---
    function initNetwork() {
      const container = document.getElementById('graphContainer');
      const data = { nodes: new vis.DataSet([]), edges: new vis.DataSet([]) };

      const options = {
        nodes: {
          shape: 'dot',
          size: 20,
          font: {
            size: 12,
            color: '#F8FAFC',
            face: 'Inter, system-ui, sans-serif',
            strokeWidth: 3,
            strokeColor: '#090d16'
          },
          borderWidth: 2,
          shadow: {
            enabled: true,
            color: 'rgba(0,0,0,0.6)',
            size: 8,
            x: 2,
            y: 4
          }
        },
        edges: {
          arrows: {
            to: { enabled: true, scaleFactor: 0.8 }
          },
          font: {
            size: 11,
            color: '#94A3B8',
            strokeWidth: 3,
            strokeColor: '#090d16',
            align: 'middle'
          },
          color: {
            color: '#475569',
            highlight: '#38BDF8',
            hover: '#64748B'
          },
          smooth: {
            enabled: true,
            type: 'cubicBezier',
            roundness: 0.2
          }
        },
        physics: {
          enabled: isPhysicsActive,
          solver: 'forceAtlas2Based',
          forceAtlas2Based: {
            gravitationalConstant: -60,
            centralGravity: 0.012,
            springLength: 120,
            springConstant: 0.08,
            damping: 0.45,
            avoidOverlap: 0.7
          },
          stabilization: {
            iterations: 120,
            updateInterval: 25
          }
        },
        interaction: {
          hover: true,
          tooltipDelay: 120,
          hideEdgesOnDrag: false,
          multiselect: false,
          navigationButtons: true,
          keyboard: false
        }
      };

      network = new vis.Network(container, data, options);

      // Event Listeners
      network.on('click', onGraphClick);
      network.on('doubleClick', onGraphDoubleClick);
      network.on('hoverNode', () => { container.style.cursor = 'pointer'; });
      network.on('blurNode', () => { container.style.cursor = 'default'; });
    }

    // --- DATA RENDERING & FILTERING ---
    function renderGraph() {
      if (!network) return;

      // 1. Determine active entity set based on Hop Focus Mode
      let allowedEntityIds = null;
      if (focusCenterEntityId) {
        allowedEntityIds = computeHopNeighborhood(focusCenterEntityId, focusHopDepth || 1);
        document.getElementById('focusModeBox').classList.remove('hidden');
        const center = rawEntities.find(e => e.id === focusCenterEntityId);
        document.getElementById('focusEntityName').textContent = center ? center.name : focusCenterEntityId;
      } else {
        document.getElementById('focusModeBox').classList.add('hidden');
      }

      // 2. Filter Entities by type & hop
      const filteredEntities = rawEntities.filter(ent => {
        if (allowedEntityIds && !allowedEntityIds.has(ent.id)) return false;
        if (activeTypeFilters.size > 0 && !activeTypeFilters.has(ent.type?.toLowerCase())) return false;
        return true;
      });

      const visibleEntityIds = new Set(filteredEntities.map(e => e.id));

      // 3. Filter Relations
      let supersededCount = 0;
      const filteredRelations = rawRelations.filter(rel => {
        const isSuperseded = Boolean(rel.valid_to);
        if (isSuperseded) supersededCount++;

        if (!showSuperseded && isSuperseded) return false;
        // Edge endpoints must be visible
        if (!visibleEntityIds.has(rel.src) || !visibleEntityIds.has(rel.dst)) return false;
        return true;
      });

      document.getElementById('supersededCountPill').textContent = supersededCount;

      // 4. Build vis.DataSet items
      const nodeItems = filteredEntities.map(ent => {
        const style = getTypeStyle(ent.type);
        const aliases = (ent.aliases && ent.aliases.length > 0) ? `\nAliases: ${ent.aliases.join(', ')}` : '';
        return {
          id: ent.id,
          label: ent.name,
          title: `[${ent.type?.toUpperCase() || 'CONCEPT'}] ${ent.name}${aliases}`,
          color: {
            background: style.bg,
            border: style.border,
            highlight: {
              background: style.highlight,
              border: '#FFFFFF'
            }
          }
        };
      });

      const edgeItems = filteredRelations.map(rel => {
        const isSuperseded = Boolean(rel.valid_to);
        return {
          id: rel.id,
          from: rel.src,
          to: rel.dst,
          label: rel.predicate,
          dashes: isSuperseded ? [5, 5] : false,
          color: {
            color: isSuperseded ? '#EF4444' : '#64748B',
            highlight: isSuperseded ? '#F87171' : '#38BDF8',
            opacity: isSuperseded ? 0.45 : 0.9
          },
          font: {
            color: isSuperseded ? '#FCA5A5' : '#94A3B8',
            strokeColor: '#090d16',
            strokeWidth: 3
          },
          title: `Predicate: ${rel.predicate}\nFrom: ${rel.valid_from || 'unknown'}${rel.valid_to ? `\nSuperseded: ${rel.valid_to}` : ' (Active)'}`
        };
      });

      // Update vis dataset
      network.setData({
        nodes: new vis.DataSet(nodeItems),
        edges: new vis.DataSet(edgeItems)
      });

      // Update Header Stats
      document.getElementById('statEntities').textContent = rawEntities.length;
      document.getElementById('statRelations').textContent = rawRelations.filter(r => !r.valid_to).length;
      document.getElementById('statMemories').textContent = rawMemories.length;

      renderFilterPills();
    }

    function computeHopNeighborhood(centerId, maxHops = 1) {
      const visited = new Set([centerId]);
      let currentBorder = new Set([centerId]);

      for (let hop = 0; hop < maxHops; hop++) {
        const nextBorder = new Set();
        for (const rel of rawRelations) {
          if (!showSuperseded && rel.valid_to) continue;

          if (currentBorder.has(rel.src) && !visited.has(rel.dst)) {
            visited.add(rel.dst);
            nextBorder.add(rel.dst);
          }
          if (currentBorder.has(rel.dst) && !visited.has(rel.src)) {
            visited.add(rel.src);
            nextBorder.add(rel.src);
          }
        }
        currentBorder = nextBorder;
        if (currentBorder.size === 0) break;
      }
      return visited;
    }

    function renderFilterPills() {
      const container = document.getElementById('typeFilterPills');
      container.innerHTML = '';

      const counts = {};
      rawEntities.forEach(e => {
        const t = (e.type || 'concept').toLowerCase();
        counts[t] = (counts[t] || 0) + 1;
      });

      Object.entries(counts).forEach(([type, count]) => {
        const style = getTypeStyle(type);
        const isActive = activeTypeFilters.size === 0 || activeTypeFilters.has(type);
        
        const pill = document.createElement('button');
        pill.className = `px-2 py-0.5 rounded-full text-[10px] font-medium border transition flex items-center gap-1.5 ${
          isActive 
            ? `${style.badge} ring-1 ring-white/20` 
            : 'bg-dark-800 text-slate-500 border-slate-700/60 opacity-60'
        }`;
        
        pill.innerHTML = `
          <span class="w-1.5 h-1.5 rounded-full" style="background-color: ${style.bg}"></span>
          <span>${type}</span>
          <span class="opacity-70 font-mono">(${count})</span>
        `;

        pill.onclick = () => {
          if (activeTypeFilters.has(type)) {
            activeTypeFilters.delete(type);
          } else {
            activeTypeFilters.add(type);
          }
          renderGraph();
        };

        container.appendChild(pill);
      });
    }

    function resetFilters() {
      activeTypeFilters.clear();
      showSuperseded = false;
      document.getElementById('chkShowSuperseded').checked = false;
      focusCenterEntityId = null;
      renderGraph();
      fitGraph();
    }

    function toggleSuperseded(checked) {
      showSuperseded = checked;
      renderGraph();
    }

    // --- GRAPH CLICK & SELECTION ---
    function onGraphClick(params) {
      if (params.nodes && params.nodes.length > 0) {
        const nodeId = params.nodes[0];
        inspectEntity(nodeId);
      } else if (params.edges && params.edges.length > 0) {
        const edgeId = params.edges[0];
        inspectRelation(edgeId);
      } else {
        closeInspector();
      }
    }

    function onGraphDoubleClick(params) {
      if (params.nodes && params.nodes.length > 0) {
        const nodeId = params.nodes[0];
        // Focus neighborhood 1-hop
        focusCenterEntityId = (focusCenterEntityId === nodeId) ? null : nodeId;
        focusHopDepth = 1;
        renderGraph();
        network.focus(nodeId, { scale: 1.2, animation: { duration: 500, easingFunction: 'easeInOutQuad' } });
      }
    }

    function clearFocusMode() {
      focusCenterEntityId = null;
      renderGraph();
      fitGraph();
    }

    // --- INSPECTOR DRAWER ---
    function inspectEntity(entityId) {
      selectedEntityId = entityId;
      const entity = rawEntities.find(e => e.id === entityId);
      if (!entity) return;

      const style = getTypeStyle(entity.type);
      const drawer = document.getElementById('inspectorDrawer');
      const title = document.getElementById('inspectorTitle');
      const icon = document.getElementById('inspectorIcon');
      const content = document.getElementById('inspectorContent');

      title.textContent = entity.name;
      drawer.classList.remove('translate-x-full');

      // Relations
      const outRels = rawRelations.filter(r => r.src === entityId);
      const inRels = rawRelations.filter(r => r.dst === entityId);

      // Grounded Memories
      const groundedMemIds = new Set(
        rawMemoryEntities.filter(me => me.entity_id === entityId).map(me => me.memory_id)
      );
      // Also include memories where relation was evidenced
      outRels.concat(inRels).forEach(r => { if (r.memory_id) groundedMemIds.add(r.memory_id); });
      const memories = rawMemories.filter(m => groundedMemIds.has(m.id));

      let aliasesHtml = '';
      if (entity.aliases && entity.aliases.length > 0) {
        aliasesHtml = `
          <div class="mt-2 flex flex-wrap gap-1">
            ${entity.aliases.map(a => `<span class="px-2 py-0.5 rounded bg-dark-800 text-slate-300 border border-slate-700 font-mono text-[10px]">${escapeHtml(a)}</span>`).join('')}
          </div>
        `;
      }

      let metadataHtml = '';
      if (entity.metadata && Object.keys(entity.metadata).length > 0) {
        metadataHtml = `
          <div class="space-y-1">
            <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Metadata</span>
            <pre class="p-2.5 rounded-lg bg-dark-950 border border-slate-800 font-mono text-[11px] text-slate-300 overflow-x-auto">${escapeHtml(JSON.stringify(entity.metadata, null, 2))}</pre>
          </div>
        `;
      }

      // Outbound Relations List
      let outRelsHtml = outRels.length === 0 ? '<div class="text-slate-500 italic text-[11px]">None</div>' : outRels.map(r => {
        const target = rawEntities.find(e => e.id === r.dst);
        const isSup = Boolean(r.valid_to);
        return `
          <div class="p-2 rounded-lg bg-dark-800/80 border border-slate-700/60 flex items-center justify-between">
            <div class="flex items-center gap-1.5 overflow-hidden">
              <span class="font-mono text-emerald-400 font-medium">${escapeHtml(r.predicate)}</span>
              <span class="text-slate-500">→</span>
              <button onclick="focusAndInspectNode('${r.dst}')" class="text-white hover:text-emerald-300 font-medium truncate underline underline-offset-2">
                ${escapeHtml(target ? target.name : r.dst)}
              </button>
            </div>
            ${isSup ? '<span class="text-[9px] px-1.5 py-0.5 rounded bg-red-950/80 text-red-400 border border-red-800">superseded</span>' : '<span class="text-[9px] px-1.5 py-0.5 rounded bg-emerald-950/80 text-emerald-400 border border-emerald-800">active</span>'}
          </div>
        `;
      }).join('');

      // Inbound Relations List
      let inRelsHtml = inRels.length === 0 ? '<div class="text-slate-500 italic text-[11px]">None</div>' : inRels.map(r => {
        const source = rawEntities.find(e => e.id === r.src);
        const isSup = Boolean(r.valid_to);
        return `
          <div class="p-2 rounded-lg bg-dark-800/80 border border-slate-700/60 flex items-center justify-between">
            <div class="flex items-center gap-1.5 overflow-hidden">
              <button onclick="focusAndInspectNode('${r.src}')" class="text-white hover:text-emerald-300 font-medium truncate underline underline-offset-2">
                ${escapeHtml(source ? source.name : r.src)}
              </button>
              <span class="text-slate-500">→</span>
              <span class="font-mono text-sky-400 font-medium">${escapeHtml(r.predicate)}</span>
            </div>
            ${isSup ? '<span class="text-[9px] px-1.5 py-0.5 rounded bg-red-950/80 text-red-400 border border-red-800">superseded</span>' : '<span class="text-[9px] px-1.5 py-0.5 rounded bg-emerald-950/80 text-emerald-400 border border-emerald-800">active</span>'}
          </div>
        `;
      }).join('');

      // Memories HTML
      let memoriesHtml = memories.length === 0 ? '<div class="text-slate-500 italic text-[11px]">No grounded memories</div>' : memories.map(m => `
        <div class="p-3.5 rounded-lg bg-dark-800 border border-slate-700/80 space-y-2.5">
          <div class="flex items-center justify-between">
            <span class="px-2 py-0.5 rounded-full text-[10px] bg-purple-950 text-purple-300 border border-purple-800 font-medium">${escapeHtml(m.category || 'general')}</span>
            <span class="text-[10px] text-slate-500 font-mono">${formatDate(m.created_at)}</span>
          </div>
          <div class="prose-dark">
            ${renderMarkdown(m.content)}
          </div>
          <div class="flex items-center justify-between pt-1.5 border-t border-slate-700/40 text-[10px] text-slate-400">
            <span class="font-mono text-slate-400">👤 ${escapeHtml(m.agent_id || 'system')}</span>
            <div class="flex gap-1 flex-wrap">
              ${(m.tags || []).map(t => `<span class="text-slate-400 font-mono">#${escapeHtml(t)}</span>`).join(' ')}
            </div>
          </div>
        </div>
      `).join('');

      const entityDesc = entity.metadata?.description || entity.metadata?.summary || entity.metadata?.notes;
      const descHtml = entityDesc ? `
        <div class="p-3.5 rounded-xl bg-dark-800/80 border border-slate-700/80 space-y-1.5">
          <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Description</span>
          <div class="prose-dark">
            ${renderMarkdown(entityDesc)}
          </div>
        </div>
      ` : '';

      content.innerHTML = `
        <!-- Entity Badge & Aliases -->
        <div class="p-3 rounded-xl bg-dark-800/80 border border-slate-700/80">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Entity Type</span>
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold ${style.badge}">
              ${escapeHtml(entity.type || 'concept')}
            </span>
          </div>
          ${aliasesHtml}
          <div class="mt-3 pt-2 border-t border-slate-700/50 flex justify-between text-[11px] text-slate-400">
            <div>Degree: <span class="text-white font-mono font-bold">${outRels.length + inRels.length}</span></div>
            <div>Grounded Memories: <span class="text-purple-400 font-mono font-bold">${memories.length}</span></div>
          </div>
        </div>

        ${descHtml}

        <!-- Quick Neighborhood Action -->
        <div class="flex gap-2">
          <button onclick="isolateEntityNeighborhood('${entity.id}')" class="flex-1 py-1.5 px-3 bg-dark-800 hover:bg-dark-700 border border-slate-700 rounded-lg text-emerald-400 hover:text-emerald-300 font-medium transition text-center flex items-center justify-center gap-1.5">
            <i data-lucide="crosshair" class="w-3.5 h-3.5"></i> Focus 1-Hop
          </button>
        </div>

        ${metadataHtml}

        <!-- Outgoing Relations -->
        <div class="space-y-2">
          <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider flex items-center justify-between">
            <span>Outgoing Relations</span>
            <span class="text-slate-500 font-mono">(${outRels.length})</span>
          </span>
          <div class="space-y-1.5 max-h-48 overflow-y-auto pr-1">
            ${outRelsHtml}
          </div>
        </div>

        <!-- Incoming Relations -->
        <div class="space-y-2">
          <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider flex items-center justify-between">
            <span>Incoming Relations</span>
            <span class="text-slate-500 font-mono">(${inRels.length})</span>
          </span>
          <div class="space-y-1.5 max-h-48 overflow-y-auto pr-1">
            ${inRelsHtml}
          </div>
        </div>

        <!-- Grounded Memories -->
        <div class="space-y-2 pt-2 border-t border-slate-800">
          <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider flex items-center justify-between">
            <span>Grounded Memories</span>
            <span class="text-slate-500 font-mono">(${memories.length})</span>
          </span>
          <div class="space-y-2 max-h-72 overflow-y-auto pr-1">
            ${memoriesHtml}
          </div>
        </div>
      `;

      lucide.createIcons();
    }

    function inspectRelation(edgeId) {
      const rel = rawRelations.find(r => r.id === edgeId);
      if (!rel) return;

      const src = rawEntities.find(e => e.id === rel.src);
      const dst = rawEntities.find(e => e.id === rel.dst);
      const isSup = Boolean(rel.valid_to);
      const evidenceMem = rawMemories.find(m => m.id === rel.memory_id);

      const drawer = document.getElementById('inspectorDrawer');
      const title = document.getElementById('inspectorTitle');
      const content = document.getElementById('inspectorContent');

      title.textContent = `Relation: ${rel.predicate}`;
      drawer.classList.remove('translate-x-full');

      content.innerHTML = `
        <div class="p-3 rounded-xl bg-dark-800/80 border border-slate-700/80 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Status</span>
            ${isSup 
              ? '<span class="px-2 py-0.5 rounded-full text-[10px] bg-red-950 text-red-400 border border-red-800 font-medium">Superseded</span>'
              : '<span class="px-2 py-0.5 rounded-full text-[10px] bg-emerald-950 text-emerald-400 border border-emerald-800 font-medium">Active</span>'
            }
          </div>

          <div class="space-y-1.5 font-mono text-xs">
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Source:</span>
              <button onclick="focusAndInspectNode('${rel.src}')" class="text-emerald-400 hover:underline font-bold">${escapeHtml(src ? src.name : rel.src)}</button>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Predicate:</span>
              <span class="text-white font-bold">${escapeHtml(rel.predicate)}</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Destination:</span>
              <button onclick="focusAndInspectNode('${rel.dst}')" class="text-sky-400 hover:underline font-bold">${escapeHtml(dst ? dst.name : rel.dst)}</button>
            </div>
          </div>

          <div class="pt-2 border-t border-slate-700/60 text-[11px] text-slate-400 space-y-1">
            <div>Valid From: <span class="font-mono text-slate-200">${formatDate(rel.valid_from)}</span></div>
            ${rel.valid_to ? `<div>Valid To: <span class="font-mono text-red-300">${formatDate(rel.valid_to)}</span></div>` : ''}
          </div>
        </div>

        ${evidenceMem ? `
          <div class="space-y-2">
            <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Grounded Evidence Memory</span>
            <div class="p-3.5 rounded-lg bg-dark-800 border border-slate-700/80 space-y-2.5">
              <div class="flex items-center justify-between">
                <span class="px-2 py-0.5 rounded-full text-[10px] bg-purple-950 text-purple-300 border border-purple-800 font-medium">${escapeHtml(evidenceMem.category)}</span>
                <span class="text-[10px] text-slate-500 font-mono">${formatDate(evidenceMem.created_at)}</span>
              </div>
              <div class="prose-dark">
                ${renderMarkdown(evidenceMem.content)}
              </div>
            </div>
          </div>
        ` : ''}
      `;
      lucide.createIcons();
    }

    function closeInspector() {
      document.getElementById('inspectorDrawer').classList.add('translate-x-full');
      selectedEntityId = null;
    }

    function focusAndInspectNode(nodeId) {
      if (!network) return;
      network.focus(nodeId, { scale: 1.2, animation: { duration: 500, easingFunction: 'easeInOutQuad' } });
      inspectEntity(nodeId);
    }

    function isolateEntityNeighborhood(nodeId) {
      focusCenterEntityId = nodeId;
      focusHopDepth = 1;
      renderGraph();
      focusAndInspectNode(nodeId);
    }

    // --- SEARCH & AUTOCOMPLETE ---
    function handleSearch(val) {
      const q = val.trim().toLowerCase();
      const dropdown = document.getElementById('searchDropdown');
      const btnClear = document.getElementById('btnClearSearch');

      if (!q) {
        dropdown.classList.add('hidden');
        btnClear.classList.add('hidden');
        return;
      }
      btnClear.classList.remove('hidden');

      const matches = rawEntities.filter(e => {
        if (e.name.toLowerCase().includes(q)) return true;
        if (e.type && e.type.toLowerCase().includes(q)) return true;
        if (e.aliases && e.aliases.some(a => a.toLowerCase().includes(q))) return true;
        return false;
      }).slice(0, 10);

      if (matches.length === 0) {
        dropdown.innerHTML = '<div class="px-3 py-2 text-slate-500 text-xs italic">No matching entities found</div>';
        dropdown.classList.remove('hidden');
        return;
      }

      dropdown.innerHTML = matches.map(e => {
        const style = getTypeStyle(e.type);
        return `
          <button onclick="selectSearchResult('${e.id}')" class="w-full px-3 py-2 text-left hover:bg-dark-700/80 flex items-center justify-between border-b border-slate-700/40 last:border-0 transition">
            <div class="overflow-hidden">
              <div class="text-white font-medium text-xs truncate">${escapeHtml(e.name)}</div>
              ${e.aliases && e.aliases.length > 0 ? `<div class="text-[10px] text-slate-400 truncate">aka: ${escapeHtml(e.aliases.join(', '))}</div>` : ''}
            </div>
            <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full ${style.badge}">${escapeHtml(e.type)}</span>
          </button>
        `;
      }).join('');

      dropdown.classList.remove('hidden');
    }

    function selectSearchResult(entityId) {
      document.getElementById('searchDropdown').classList.add('hidden');
      focusAndInspectNode(entityId);
    }

    function clearSearch() {
      document.getElementById('searchInput').value = '';
      document.getElementById('searchDropdown').classList.add('hidden');
      document.getElementById('btnClearSearch').classList.add('hidden');
    }

    // --- TOOLBAR CONTROLS ---
    function fitGraph() {
      if (network) network.fit({ animation: { duration: 600, easingFunction: 'easeInOutQuad' } });
    }

    function togglePhysics() {
      isPhysicsActive = !isPhysicsActive;
      network.setOptions({ physics: { enabled: isPhysicsActive } });
      const btn = document.getElementById('btnPhysicsToggle');
      if (isPhysicsActive) {
        btn.classList.add('text-emerald-400');
        btn.classList.remove('text-slate-400');
      } else {
        btn.classList.remove('text-emerald-400');
        btn.classList.add('text-slate-400');
      }
    }

    function toggleLayoutMode() {
      isHierarchical = !isHierarchical;
      if (isHierarchical) {
        network.setOptions({
          layout: {
            hierarchical: {
              enabled: true,
              direction: 'LR',
              sortMethod: 'directed',
              levelSeparation: 150,
              nodeSpacing: 100
            }
          }
        });
      } else {
        network.setOptions({
          layout: { hierarchical: { enabled: false } },
          physics: { enabled: isPhysicsActive }
        });
      }
      fitGraph();
    }

    function exportPNG() {
      if (!network) return;
      const canvas = document.querySelector('#graphContainer canvas');
      if (!canvas) return;
      const dataURL = canvas.toDataURL('image/png');
      const a = document.createElement('a');
      a.href = dataURL;
      a.download = `raymond-knowledge-graph-${Date.now()}.png`;
      a.click();
    }

    // --- SUPABASE DATA SYNC ---
    async function fetchFromSupabase(url, key) {
      updateStatusBadge('connecting', 'Connecting...');
      
      const cleanUrl = url.replace(/\/+$/, '');
      const headers = {
        'apikey': key,
        'Authorization': `Bearer ${key}`,
        'Content-Type': 'application/json'
      };

      try {
        const [entRes, relRes, memRes, memEntRes] = await Promise.all([
          fetch(`${cleanUrl}/rest/v1/entities?select=*&order=created_at.desc&limit=500`, { headers }),
          fetch(`${cleanUrl}/rest/v1/relations?select=*&order=created_at.desc&limit=1000`, { headers }),
          fetch(`${cleanUrl}/rest/v1/memories?select=id,agent_id,session_id,category,content,tags,created_at,metadata&order=created_at.desc&limit=300`, { headers }),
          fetch(`${cleanUrl}/rest/v1/memory_entities?select=memory_id,entity_id`, { headers }),
        ]);

        if (!entRes.ok) throw new Error(`Entities query failed: ${entRes.statusText}`);
        if (!relRes.ok) throw new Error(`Relations query failed: ${relRes.statusText}`);

        rawEntities = await entRes.json();
        rawRelations = await relRes.json();
        rawMemories = memRes.ok ? await memRes.json() : [];
        rawMemoryEntities = memEntRes.ok ? await memEntRes.json() : [];

        // Save to localStorage
        localStorage.setItem('raymond_supabase_url', cleanUrl);
        localStorage.setItem('raymond_supabase_key', key);

        updateStatusBadge('connected', 'Live Supabase');
        closeSettingsModal();
        renderGraph();
        setTimeout(fitGraph, 300);
      } catch (err) {
        console.error("Supabase fetch error:", err);
        updateStatusBadge('error', 'Sync Failed');
        throw err;
      }
    }

    function loadDemoDataset() {
      rawEntities = JSON.parse(JSON.stringify(DEMO_DATASET.entities));
      rawRelations = JSON.parse(JSON.stringify(DEMO_DATASET.relations));
      rawMemories = JSON.parse(JSON.stringify(DEMO_DATASET.memories));
      rawMemoryEntities = JSON.parse(JSON.stringify(DEMO_DATASET.memory_entities));

      updateStatusBadge('demo', 'Demo Dataset');
      closeSettingsModal();
      renderGraph();
      setTimeout(fitGraph, 200);
    }

    async function refreshData() {
      // 1. Try refreshing via local proxy
      try {
        const proxyRes = await fetch('/api/graph?refresh=true');
        if (proxyRes.ok) {
          const graphJson = await proxyRes.json();
          if (graphJson && graphJson.entities) {
            applyGraphJson(graphJson, 'Live Edge Proxy');
            return;
          }
        }
      } catch (_) {}

      // 2. Try direct Supabase
      const url = document.getElementById('cfgSupabaseUrl').value.trim();
      const key = document.getElementById('cfgSupabaseKey').value.trim();
      if (url && key) {
        try {
          await fetchFromSupabase(url, key);
        } catch (e) {
          alert("Failed to refresh from Supabase: " + e.message);
        }
      } else {
        loadDemoDataset();
      }
    }

    function updateStatusBadge(state, text) {
      const indicator = document.getElementById('statusIndicator');
      const textElem = document.getElementById('statusText');
      textElem.textContent = text;

      indicator.className = 'w-2 h-2 rounded-full';
      if (state === 'connected') {
        indicator.classList.add('bg-emerald-400');
      } else if (state === 'connecting') {
        indicator.classList.add('bg-amber-400', 'animate-pulse');
      } else if (state === 'demo') {
        indicator.classList.add('bg-sky-400');
      } else {
        indicator.classList.add('bg-red-400');
      }
    }

    // --- MODAL CONTROLS ---
    function openSettingsModal() {
      document.getElementById('settingsModal').classList.remove('hidden');
      lucide.createIcons();
    }

    function closeSettingsModal() {
      document.getElementById('settingsModal').classList.add('hidden');
    }

    async function saveAndConnectSupabase() {
      const url = document.getElementById('cfgSupabaseUrl').value.trim();
      const key = document.getElementById('cfgSupabaseKey').value.trim();
      const alertBox = document.getElementById('modalStatusAlert');

      if (!url || !key) {
        alertBox.className = 'p-3 rounded-lg border text-xs bg-red-950/60 text-red-300 border-red-800';
        alertBox.textContent = 'Please enter both Supabase URL and API Key.';
        alertBox.classList.remove('hidden');
        return;
      }

      alertBox.className = 'p-3 rounded-lg border text-xs bg-amber-950/60 text-amber-300 border-amber-800';
      alertBox.textContent = 'Connecting to Supabase...';
      alertBox.classList.remove('hidden');

      try {
        await fetchFromSupabase(url, key);
        alertBox.classList.add('hidden');
      } catch (err) {
        alertBox.className = 'p-3 rounded-lg border text-xs bg-red-950/60 text-red-300 border-red-800';
        alertBox.textContent = `Connection error: ${err.message}`;
        alertBox.classList.remove('hidden');
      }
    }

    // --- UTILITIES ---
    let isDrawerExpanded = false;
    function toggleDrawerWidth() {
      const drawer = document.getElementById('inspectorDrawer');
      const icon = document.getElementById('iconDrawerWidth');
      isDrawerExpanded = !isDrawerExpanded;
      if (isDrawerExpanded) {
        drawer.classList.remove('w-96');
        drawer.classList.add('w-full', 'md:w-[620px]');
        icon.setAttribute('data-lucide', 'minimize-2');
      } else {
        drawer.classList.remove('w-full', 'md:w-[620px]');
        drawer.classList.add('w-96');
        icon.setAttribute('data-lucide', 'maximize-2');
      }
      lucide.createIcons();
    }

    function renderMarkdown(md) {
      if (!md) return '';
      if (typeof marked !== 'undefined') {
        try {
          return marked.parse(String(md));
        } catch (e) {
          console.warn("Markdown parse error:", e);
        }
      }
      return escapeHtml(md).replace(/\n/g, '<br>');
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function formatDate(ts) {
      if (!ts) return '';
      try {
        const d = new Date(ts);
        return d.toLocaleDateString() + ' ' + d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      } catch (_) {
        return String(ts);
      }
    }
  </script>
</body>
</html>
